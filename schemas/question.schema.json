{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/audaykumarr/devops-interview-kb/blob/main/schemas/question.schema.json",
  "title": "DevOps Interview Question",
  "description": "Frontmatter schema for a single question file under content/<category>/<subcategory>/<slug>.md. The category value must also exist in schemas/taxonomy.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "subcategory",
    "technologies",
    "difficulty",
    "question_type",
    "tags",
    "estimated_time_minutes",
    "status",
    "last_reviewed",
    "last_updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Globally unique identifier. Convention: <category>-<subcategory>-<short-topic>-<3-digit-sequence>.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 15,
      "maxLength": 220,
      "description": "The interview question itself, phrased as a real, specific question (not a topic label). Scenario-style questions run longer than definition-style ones by design; keep it as tight as the scenario allows."
    },
    "category": {
      "type": "string",
      "description": "Must match a slug in schemas/taxonomy.json.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "subcategory": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "technologies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"]
    },
    "question_type": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "conceptual",
          "practical",
          "troubleshooting",
          "scenario",
          "architecture",
          "hands-on",
          "command-line",
          "configuration",
          "coding",
          "system-design",
          "security",
          "behavioral",
          "comparison"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "estimated_time_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "companies": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "related_questions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{3}$" },
      "default": [],
      "description": "IDs of other questions. Validated for existence and non-self-reference by scripts/validate-content.ts."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "deprecated"]
    },
    "last_reviewed": {
      "type": "string",
      "format": "date",
      "description": "Date this content was last confirmed technically accurate, YYYY-MM-DD."
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "Date the file content last changed, YYYY-MM-DD."
    },
    "technology_version": {
      "type": "object",
      "description": "Explicit versions referenced in the answer, for version-sensitive content, e.g. { \"kubernetes\": \"1.34\" }.",
      "additionalProperties": { "type": "string" }
    },
    "author": {
      "type": "string",
      "description": "GitHub username of the original author, for attribution.",
      "pattern": "^[A-Za-z0-9-]{1,39}$"
    }
  }
}
