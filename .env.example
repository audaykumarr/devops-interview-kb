# Production origin, no trailing slash. Used for canonical URLs, OpenGraph/Twitter
# metadata, the sitemap, and robots.txt. Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Google Analytics 4 Measurement ID. Leave unset to disable analytics entirely
# (local dev and preview deploys should generally leave this unset).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
